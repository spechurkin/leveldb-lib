use strict;
use warnings;
use utf8;
use Test::More;
use File::Temp qw(tempdir);
use MultiLevelDB;
{
    my $root = tempdir(DIR => $ENV{ML_TEST_ROOT} || File::Temp::tempdir(), CLEANUP => 1);
    my $fresh = $root . '/новая';
    my $options = { create_if_missing => 0, error_if_exists => 0, cache_size => 0 };
    my $created = MultiLevelDB::Database->create($fresh, $options);
    my $cursor = $created->iterator;
    $cursor->seek_to_first;
    ok(!$cursor->is_valid, 'created database is empty');
    $cursor->close;
    $created->put("\0\xff", "\x80\0");
    eval {MultiLevelDB::Database->create($fresh)};
    is($@->code, 'DATABASE_LOCKED', 'create respects lock');
    $created->close;
    eval {MultiLevelDB::Database->create($fresh, $options)};
    is($@->code, 'INVALID_ARGUMENT', 'create rejects existing database');
    $created = MultiLevelDB::Database->open($fresh, $options);
    is($created->get("\0\xff"), "\x80\0", 'failed create preserves data');
    $created->close;
    eval {MultiLevelDB::Database->open($root . '/absent', $options)};
    is($@->code, 'INVALID_ARGUMENT', 'create preserves options');
    $created = MultiLevelDB::Database->create($root . '/defaults');
    $created->close;
    eval {MultiLevelDB::Database->create('')};
    is($@->code, 'INVALID_ARGUMENT', 'create validates path');
}
my $path = tempdir(DIR => $ENV{ML_TEST_ROOT} || File::Temp::tempdir(), CLEANUP => 1) . '/данные';
my $db = MultiLevelDB::Database->open($path, { create_if_missing => 1, compression => 'none',
    error_if_exists                                              => 0, paranoid_checks => 1, write_buffer_size => 65536, max_open_files => 40,
    block_size                                                   => 4096, block_restart_interval => 16, cache_size => 1048576 });
my ($key, $value) = ("\0\xff", "\0\x80\xff");
$db->put($key, $value, { sync => 1 });
is($db->get($key, { verify_checksums => 1, fill_cache => 0 }), $value, 'binary roundtrip');
eval {MultiLevelDB::Database->open($path);};
is($@->code, 'DATABASE_LOCKED', 'locked');
my $s = $db->create_snapshot;
my $b = $db->create_batch;
$b->put($key, '')->put('z', $value)->delete('z');
$db->write($b);
$b->clear;
$b->close;
$b->close;
is($db->get($key), '', 'empty exists');
is($db->get($key, undef, $s), $value, 'snapshot');
my $i = $db->iterator(undef, $s);
$s->close;
$i->seek($key);
ok($i->is_valid, 'seek');
is($i->key, $key, 'key');
is($i->value, $value, 'snapshot retained');
$i->seek_to_first;
$i->seek_to_last;
$i->previous;
ok(!$i->is_valid, 'before beginning');
$i->seek_to_first;
$i->next;
ok(!$i->is_valid, 'end');
$i->status;
$i->close;
$db->delete($key);
ok(!defined $db->get($key), 'missing');
my $large = "\xff" x (4 * 1024 * 1024);
$db->put($key, $large);
is($db->get($key), $large, 'large');
$db->close;
$db->close;
eval {$db->get($key)};
is($@->code, 'DATABASE_CLOSED', 'closed');
$db = MultiLevelDB::Database->open($path);
is(length($db->get($key)), length($large), 'reopen');
$db->close;
done_testing;
